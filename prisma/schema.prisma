// Схема бази даних кабінету психолога.
// Prisma 7 + PostgreSQL (Fly Postgres у продакшені).

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- користувачі

enum Role {
  ADMIN
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null у тих, хто входить лише через Google
  image         String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile  ClientProfile?
  sessions Session[]
  homework Homework[]
  results  TestResult[]
  posts    Post[]
  invites  TestInvite[]

  // NextAuth
  accounts     Account[]
  authSessions AuthSession[]

  @@index([role])
}

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone     String?
  birthDate DateTime?
  diagnosis String?
  notes     String? // приватні нотатки психологині, клієнт їх не бачить

  // тека клієнта в Google Drive психологині
  driveFolderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------- сесії

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  datetime        DateTime
  durationMinutes Int           @default(50)
  status          SessionStatus @default(SCHEDULED)
  notes           String? // нотатки психологині після зустрічі

  // подія в Google Calendar психологині
  googleEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, datetime])
  @@index([datetime])
}

// ---------------------------------------------------------------- домашні завдання

enum HomeworkStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Homework {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String
  status      HomeworkStatus @default(PENDING)

  clientAnswer String?
  answeredAt   DateTime?
  dueDate      DateTime?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Attachment {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  fileName String
  mimeType String
  size     Int
  url      String // локальне сховище або S3/Drive
  driveId  String?

  createdAt DateTime @default(now())

  @@index([homeworkId])
}

// ------------------------------------------------------------------- тести

model TestResult {
  id String @id @default(cuid())

  // Порожній у сторонніх людей: анкету можна пройти за посиланням без входу
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  testName   String
  score      Int?
  rawAnswers Json
  aiSummary  String? // клінічне резюме від LLM, імена замасковані перед відправкою

  completedAt DateTime @default(now())

  invite TestInvite?

  @@index([userId, testName])
}

// ------------------------------------------------------- посилання на анкети

enum InviteStatus {
  SENT // посилання створено й віддано людині
  OPENED // сторінку відкрили, але анкету не завершили
  COMPLETED // відповіді збережено
}

/// Одне посилання на одну анкету. Працює без входу, тож придатне і своїм
/// клієнтам, і стороннім людям.
model TestInvite {
  id       String @id @default(cuid())
  token    String @unique // те, що стоїть в адресі /t/<token>
  testSlug String

  /// Для кого й навіщо — службовий підпис, людина його не бачить
  label String?

  /// Заповнено, якщо анкету надіслано своєму клієнту
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Стороння людина називає себе сама перед початком
  respondentName  String?
  respondentEmail String?

  status      InviteStatus @default(SENT)
  openedAt    DateTime?
  completedAt DateTime?
  /// Після цієї миті посилання не відкривається; null — безстрокове
  expiresAt   DateTime?

  resultId String?     @unique
  result   TestResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId])
  @@index([testSlug])
}

// -------------------------------------------------------------------- блог

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  // Короткий опис для картки й для прев'ю посилання. Якщо порожній,
  // збирається з початку тексту.
  excerpt String?

  // Тіло допису в спрощеній розмітці — див. lib/rich-text.tsx.
  // Зберігаємо як написала авторка; у HTML не перетворюємо й не вставляємо
  // через dangerouslySetInnerHTML, а збираємо React-вузли.
  body String

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  // Обкладинка лежить у тому ж сховищі, що й вкладення домашніх завдань
  // (lib/storage.ts). coverName — ім'я файла на диску, не оригінальне.
  coverName String?
  coverMime String?
  coverAlt  String?

  // Якщо допис уже вийшов у соцмережах, картка веде туди, а не на сторінку
  // допису; sourceLabel замінює дату в картці («Instagram · Reels»).
  externalUrl String?
  sourceLabel String?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

// ---------------------------------------------------------------- NextAuth

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Сесії автентифікації. Названо AuthSession, щоб не плутати з Session —
// зустріччю клієнта з психологинею.
model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
